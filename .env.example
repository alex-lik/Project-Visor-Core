# Project Visor Configuration
PORT=3000
NODE_ENV=production

# Security & Session Secret (generate with openssl rand -hex 32)
JWT_SECRET=replace-with-a-very-strong-secret-key-32-chars-long

# Database (Default: local SQLite database file)
DATABASE_URL=file:./data/visor.db

# Optional Prometheus URL for cluster telemetry
PROMETHEUS_URL=http://localhost:9090
